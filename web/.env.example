# No variables are required: the app reads only the bundled data/analytics.db.

# Optional: canonical site URL used for metadata and Open Graph links.
# When unset, the app follows Next.js's fallback: the Vercel production domain
# (VERCEL_PROJECT_PRODUCTION_URL) on production deploys, the branch URL on
# previews, and http://localhost:$PORT (default 3000) locally.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
