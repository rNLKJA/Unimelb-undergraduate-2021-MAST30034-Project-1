# ---------------------------------------------------------------- data (never commit raw data)
# Revival cache: 12 monthly TLC Parquet files (~1.2 GB), extracted side inputs and
# the DuckDB work file (~27 GB). Recreate with `uv run scripts/fetch_data.py`
# and `uv run scripts/pipeline.py`.
/data-cache/

# The 2021 notebook's own data folders (filled by coursework/Download scripts)
/coursework/Data/
/coursework/Preprocess/*
!/coursework/Preprocess/.gitkeep
!/coursework/Preprocess/preprocess_readme.md
**/tmp
